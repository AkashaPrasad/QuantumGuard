    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@noble/post-quantum": "0.7.1",
    "@tanstack/react-query": "5.107.1",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.5.2",
    "driver.js": "1.12.1",
    "idb-keyval": "6.3.0",
    "lucide-react": "1.72.0",
    "motion": "14.12.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
