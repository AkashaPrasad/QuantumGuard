{
  // The hostname, the API address and the edge key are not stored here: deploy.sh passes the first two on the
  // command line and stores the key as a Worker secret.
  "name": "quantumguard-web",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/healthz"]
  }
}
