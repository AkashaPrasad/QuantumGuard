{
  "$id": "certificate.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "examples": [
    {
      "created_at": "2026-11-26T12:00:00.000Z",
      "device_id": "dev_AAAAAAAAAAAAAAAAAAAAAA",
      "directory_epoch": 2,
      "expires_at": "2026-11-26T12:00:00.000Z",
      "kem_pk": "a2VtLXBr",
      "name": "Aiko's laptop",
      "sig_pk": "c2lnLXBr",
      "signatures": {
        "ed25519": "c2lnbmF0dXJlLWV4YW1wbGU",
        "mldsa": "bWxkc2Etc2lnbmF0dXJlLWV4YW1wbGU"
      },
      "suite": "QG-1",
      "user_id": "usr_AAAAAAAAAAAAAAAAAAAAAA"
    }
  ],
  "properties": {
    "created_at": {
      "format": "date-time",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$",
      "type": "string"
    },
    "device_id": {
      "pattern": "^[a-z]{3}_[A-Za-z0-9_-]{22}$",
      "type": "string"
    },
    "directory_epoch": {
      "type": "integer"
    },
    "expires_at": {
      "format": "date-time",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$",
      "type": "string"
    },
    "kem_pk": {
      "description": "base64url without padding",
      "pattern": "^[A-Za-z0-9_-]*$",
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "sig_pk": {
      "description": "base64url without padding",
      "pattern": "^[A-Za-z0-9_-]*$",
      "type": "string"
    },
    "signatures": {
      "additionalProperties": false,
      "properties": {
        "ed25519": {
          "description": "base64url without padding",
          "pattern": "^[A-Za-z0-9_-]*$",
          "type": "string"
        },
        "mldsa": {
          "description": "base64url without padding",
          "pattern": "^[A-Za-z0-9_-]*$",
          "type": "string"
        }
      },
      "required": [
        "ed25519",
        "mldsa"
      ],
      "type": "object"
    },
    "suite": {
      "const": "QG-1"
    },
    "user_id": {
      "pattern": "^[a-z]{3}_[A-Za-z0-9_-]{22}$",
      "type": "string"
    }
  },
  "required": [
    "created_at",
    "device_id",
    "directory_epoch",
    "expires_at",
    "kem_pk",
    "name",
    "sig_pk",
    "signatures",
    "suite",
    "user_id"
  ],
  "title": "certificate",
  "type": "object"
}
