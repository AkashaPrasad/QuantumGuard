{
    admin off
    auto_https disable_redirects
    persist_config off
}

https://localhost:8443 {
    tls internal
    header Strict-Transport-Security "max-age=31536000"
    reverse_proxy quantumguard:8080 {
        # Set, do not append: the client must not be able to choose its own address.
        header_up X-Forwarded-For {remote_host}
    }
}
