#!/usr/bin/env bash
# Blocks secret-bearing files and runs gitleaks on staged changes when it is installed.
set -euo pipefail
if git diff --cached --name-only | grep -Eq '(^|/)(info\.txt|\.env(\..+)?)$' \
   && ! git diff --cached --name-only | grep -Eq '(^|/)\.env\.example$'; then
  echo "pre-commit: refusing to commit info.txt or .env files." >&2
  exit 1
fi
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks protect --staged --redact --no-banner
fi
