# secrets and local tooling: never commit
info.txt
.env
.env.*
!.env.example
.herd/

# runtime state
data/
keys/
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.qgkeystore

# python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
*.egg-info/

# node
node_modules/
web/dist/
web/test-results/
web/playwright-report/
*.tsbuildinfo

# os and editors
.DS_Store
.idea/
.vscode/

# browser automation output
.playwright-mcp/

# generated by the security test run
/claims.json

# brief drafts that failed a check (brief/brief.pdf itself is committed)
brief/brief.draft.pdf

# hosted deployment state (holds the edge key and account identifiers)
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
.wrangler/
